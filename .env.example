# ============================================================
# AI Threat Brief — Environment Variables
# ============================================================
# Copy this file:  cp .env.example .env.local
# Then fill in the values below.
# ============================================================

# ----------------------------------------------------------
# Supabase  (Project Settings → API)
# ----------------------------------------------------------
# Frontend client URL — find at: Supabase Dashboard → Settings → API → Project URL
VITE_SUPABASE_URL=https://your-project.supabase.co

# Anon / public key — same key, two names:
#   • VITE_SUPABASE_PUBLISHABLE_KEY  → used by the auto-generated Vite client (src/integrations/supabase/client.ts)
#   • SUPABASE_ANON_KEY              → used by edge functions and backend scripts
# Find at: Supabase Dashboard → Settings → API → Project API keys → anon (public)
VITE_SUPABASE_PUBLISHABLE_KEY=eyJ...
SUPABASE_ANON_KEY=eyJ...

# Service-role key — NEVER expose to the browser. Used only in edge functions.
# Find at: Supabase Dashboard → Settings → API → Project API keys → service_role (secret)
# In Lovable Cloud this is configured as a runtime secret, not in .env.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ----------------------------------------------------------
# App URL
# ----------------------------------------------------------
# Canonical domain. Both names point to the same value.
#   • VITE_APP_URL           → Vite frontend
#   • NEXT_PUBLIC_APP_URL    → Node/Bun automation scripts (newsletter links, etc.)
VITE_APP_URL=https://aithreatbrief.com
NEXT_PUBLIC_APP_URL=https://aithreatbrief.com

# ----------------------------------------------------------
# Stripe  (https://dashboard.stripe.com/apikeys)
# ----------------------------------------------------------
# Publishable key — safe for the browser
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Secret key & webhook secret — edge functions only (Lovable Cloud runtime secrets)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Price IDs — Stripe Dashboard → Products → select product → Pricing → copy ID
STRIPE_PRICE_PRO_MONTHLY=price_...
STRIPE_PRICE_PRO_YEARLY=price_...
STRIPE_PRICE_ENTERPRISE=price_...

# ----------------------------------------------------------
# Beehiiv  (https://app.beehiiv.com → Settings → Integrations → API)
# ----------------------------------------------------------
BEEHIIV_API_KEY=your-beehiiv-api-key
BEEHIIV_PUBLICATION_ID=your-publication-id

# Optional automation IDs (Beehiiv → Automations → select automation → copy ID)
BEEHIIV_WELCOME_AUTOMATION_ID=
# Falls back to BEEHIIV_WELCOME_AUTOMATION_ID if not set
BEEHIIV_LEAD_AUTOMATION_ID=

# ----------------------------------------------------------
# Affiliate Links  (used by Node/Bun scripts in scripts/ and lib/)
# ----------------------------------------------------------
# If you also need these in the Vite UI, duplicate with VITE_AFFILIATE_* prefix.
AFFILIATE_NORDVPN=
AFFILIATE_PUREVPN=
AFFILIATE_PROTON=
AFFILIATE_PROTON_VPN=
AFFILIATE_PROTON_MAIL=
AFFILIATE_SURFSHARK=
AFFILIATE_INCOGNI=

# ----------------------------------------------------------
# GitHub Automation  (https://github.com/settings/tokens)
# ----------------------------------------------------------
# Personal access token with repo scope — used by GitHub Actions workflows
GITHUB_TOKEN=ghp_...

# ----------------------------------------------------------
# Analytics
# ----------------------------------------------------------
# Plausible domain (https://plausible.io → Sites)
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=aithreatbrief.com

# LinkedIn Insight Tag (Campaign Manager → Account Assets → Insight Tag)
NEXT_PUBLIC_LINKEDIN_PARTNER_ID=
NEXT_PUBLIC_LINKEDIN_CONVERSION_PRO_SIGNUP=
NEXT_PUBLIC_LINKEDIN_PROFILE_URL=https://www.linkedin.com/in/josh-cabana-351631393/

# ----------------------------------------------------------
# Upstash Redis Rate Limiting  (https://console.upstash.com)
# ----------------------------------------------------------
UPSTASH_REDIS_REST_URL=https://your-upstash-redis-url.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-redis-rest-token

# ----------------------------------------------------------
# Misc
# ----------------------------------------------------------
# Set to "true" only after Beehiiv paid subscriptions are live
NEXT_PUBLIC_PRO_CHECKOUT_LIVE=
# Assessment funnel URLs
NEXT_PUBLIC_ASSESSMENT_BOOKING_URL=
NEXT_PUBLIC_ASSESSMENT_PAYMENT_URL=
